# Salin ke .env.local (jangan commit .env.local)
# Panduan: docs/SUPABASE-SETUP.md + docs/DOCKER.md

# --- App ---
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase Postgres (Prisma) ---
# Pooler Transaction (6543) — runtime / Docker / Vercel
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct (5432) — prisma migrate
DIRECT_URL=postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# --- Supabase Storage (server only; login = Better Auth) ---
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Seed ---
SEED_ADMIN_EMAIL=admin@cermin.local
SEED_ADMIN_PASSWORD=change-me-strong
SEED_ADMIN_NAME=Administrator
