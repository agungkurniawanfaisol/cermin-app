generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TERAPIS
  ORANG_TUA
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum StudentStatus {
  ACTIVE
  ARCHIVED
}

enum StoryStatus {
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum MediaKind {
  IMAGE
  AUDIO
}

enum TextSize {
  SM
  MD
  LG
  XL
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  image         String?
  role          UserRole   @default(ORANG_TUA)
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  sessions             Session[]
  accounts             Account[]
  preference           UserPreference?
  therapistAssignments TherapistAssignment[] @relation("TherapistAssignments")
  assignmentsCreated   TherapistAssignment[] @relation("AssignmentCreator")
  parentLinks          ParentLink[]
  invitesCreated       InviteToken[]
  auditLogs            AuditLog[]
  storiesCreated       Story[]               @relation("StoryCreator")
  storyVersionsCreated StoryVersion[]        @relation("StoryVersionCreator")
  mediaCreated         MediaAsset[]
  sessionsLed          LearningSession[]
  observations         SessionObservation[]
  faqsCreated          FaqItem[]        @relation("FaqCreator")
  guidesUploaded       GuideDocument[] @relation("GuideUploader")

  // List pengguna: filter peran/status + sort
  @@index([role, status])
  @@index([status, createdAt(sort: Desc)])
  @@index([name])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

model UserPreference {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  textSize     TextSize @default(MD)
  audioEnabled Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("user_preferences")
}

model Student {
  id          String        @id @default(uuid()) @db.Uuid
  /// Nama panggilan — dipakai di daftar & child mode.
  displayName String
  /// Nama lengkap sesuai dokumen / identitas.
  fullName    String?
  dateOfBirth DateTime?     @db.Date
  homeAddress String?
  rt          String?       @db.VarChar(10)
  rw          String?       @db.VarChar(10)
  /// Nomor telepon kontak (biasanya orang tua / wali).
  phone       String?       @db.VarChar(32)
  emergencyContactName  String?
  emergencyContactPhone String? @db.VarChar(32)
  /// Bahasa yang dipakai di rumah (mis. Indonesia, Sunda).
  homeLanguage String?
  /// Preferensi sensorik untuk panduan sesi / child mode.
  preferQuiet    Boolean @default(false)
  preferDimLight Boolean @default(false)
  sensoryNotes   String?
  /// Alergi / catatan medis singkat — hanya Admin.
  allergies String?
  /// Jika true, sesi tidak bisa dimulai tanpa foto profil.
  requirePhotoForSession Boolean @default(false)
  /// Private Storage key in bucket cermin-media (avatars/students/…). Not a public URL.
  imageKey         String?
  /// Foto ayah (profil keluarga) — opsional; bukan foto akun login Ortu.
  fatherImageKey   String?
  /// Foto ibu (profil keluarga) — opsional; bukan foto akun login Ortu.
  motherImageKey   String?
  adminNotes  String?
  status      StudentStatus @default(ACTIVE)
  /// Alasan arsip/hapus lunak — wajib saat status → ARCHIVED (Admin).
  archivedReason String?
  archivedAt     DateTime?
  archivedById   String?   @db.Uuid
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  therapistAssignments TherapistAssignment[]
  parentLinks          ParentLink[]
  learningSessions     LearningSession[]
  mediaAssets          MediaAsset[]

  // List murid: filter status + sort nama / tanggal dibuat
  @@index([status, displayName])
  @@index([status, createdAt(sort: Desc)])
  @@index([displayName])
  @@map("students")
}

model TherapistAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  therapistId  String    @db.Uuid
  studentId    String    @db.Uuid
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  assignedById String    @db.Uuid
  therapist    User      @relation("TherapistAssignments", fields: [therapistId], references: [id])
  student      Student   @relation(fields: [studentId], references: [id])
  assignedBy   User      @relation("AssignmentCreator", fields: [assignedById], references: [id])

  @@index([therapistId])
  @@index([studentId])
  // listActiveStudents / authz: therapistId + endedAt IS NULL
  @@index([therapistId, endedAt])
  // Partial unique: at most one active assignment per (therapistId, studentId).
  // Prisma cannot express WHERE "endedAt" IS NULL; enforced in migration:
  // CREATE UNIQUE INDEX therapist_assignments_active_unique
  //   ON therapist_assignments ("therapistId", "studentId") WHERE "endedAt" IS NULL;
  @@map("therapist_assignments")
}

model ParentLink {
  id            String  @id @default(uuid()) @db.Uuid
  parentId      String  @db.Uuid
  studentId     String  @db.Uuid
  relationLabel String?
  isActive      Boolean @default(true)
  parent        User    @relation(fields: [parentId], references: [id])
  student       Student @relation(fields: [studentId], references: [id])

  @@unique([parentId, studentId])
  @@index([studentId])
  // userHasAnyStudentAccess / list ortu: parentId + isActive
  @@index([parentId, isActive])
  @@map("parent_links")
}

model InviteToken {
  id          String    @id @default(uuid()) @db.Uuid
  email       String
  name        String
  role        UserRole
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String    @db.Uuid
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([email])
  @@map("invite_tokens")
}

model StoryCategory {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  description String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)
  /// Private Storage key in bucket cermin-media (categories/…). Cover kartu pilih kategori.
  imageKey    String?
  stories     Story[]

  // listActiveCategories: isActive + sortOrder
  @@index([isActive, sortOrder])
  @@map("story_categories")
}

model Story {
  id                 String      @id @default(uuid()) @db.Uuid
  categoryId         String      @db.Uuid
  title              String
  description        String      @default("")
  learningObjectives String      @default("")
  status             StoryStatus @default(DRAFT)
  createdById        String      @db.Uuid
  publishedAt        DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  category           StoryCategory @relation(fields: [categoryId], references: [id])
  createdBy          User          @relation("StoryCreator", fields: [createdById], references: [id])
  pages              StoryPage[]
  versions           StoryVersion[]
  media              MediaAsset[]
  learningSessions   LearningSession[]

  // List cerita: filter kategori+status; status+sort updated/title
  @@index([categoryId, status])
  @@index([status, updatedAt(sort: Desc)])
  @@index([status, title])
  @@map("stories")
}

model StoryVersion {
  id           String   @id @default(uuid()) @db.Uuid
  storyId      String   @db.Uuid
  versionNo    Int
  snapshotJson Json
  createdById  String   @db.Uuid
  createdAt    DateTime @default(now())
  story        Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  createdBy    User     @relation("StoryVersionCreator", fields: [createdById], references: [id])

  @@unique([storyId, versionNo])
  @@map("story_versions")
}

model StoryPage {
  id        String   @id @default(uuid()) @db.Uuid
  storyId   String   @db.Uuid
  sortOrder Int
  /// Judul singkat halaman (editor / pratinjau); teks cerita tetap di bodyText.
  title     String   @default("")
  bodyText  String   @default("")
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  media     MediaAsset[]
  /// Maks 1 soal MCQ per halaman (opsional).
  mcq       PageMcq?

  @@unique([storyId, sortOrder])
  @@map("story_pages")
}

model MediaAsset {
  id            String     @id @default(uuid()) @db.Uuid
  storyId       String?    @db.Uuid
  pageId        String?    @db.Uuid
  /// Null = media bersama; set = gambar personalisasi murid pada halaman.
  studentId     String?    @db.Uuid
  kind          MediaKind
  storageBucket String     @default("cermin-media")
  storageKey    String
  mimeType      String
  byteSize      Int
  altText       String?
  sortOrder     Int        @default(0)
  createdById   String     @db.Uuid
  createdAt     DateTime   @default(now())
  story         Story?     @relation(fields: [storyId], references: [id], onDelete: Cascade)
  page          StoryPage? @relation(fields: [pageId], references: [id], onDelete: Cascade)
  student       Student?   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdBy     User       @relation(fields: [createdById], references: [id])

  @@index([pageId])
  @@index([storyId])
  @@index([studentId])
  @@index([pageId, studentId])
  // Cover story-level + filter kind: storyId + kind + pageId (null = cover)
  @@index([storyId, kind, pageId])
  // Partial unique: one personalized IMAGE per (page, student).
  // Prisma cannot express WHERE; enforced in migration:
  // CREATE UNIQUE INDEX media_assets_page_student_image_unique
  //   ON media_assets ("pageId", "studentId")
  //   WHERE kind = 'IMAGE' AND "studentId" IS NOT NULL AND "pageId" IS NOT NULL;
  @@map("media_assets")
}

model FaqItem {
  id          String   @id @default(uuid()) @db.Uuid
  question    String
  answer      String
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User     @relation("FaqCreator", fields: [createdById], references: [id])

  @@index([isPublished, sortOrder])
  @@map("faq_items")
}

model GuideDocument {
  id               String   @id @default(uuid()) @db.Uuid
  title            String
  sortOrder        Int      @default(0)
  isPublished      Boolean  @default(true)
  storageBucket    String   @default("cermin-media")
  storageKey       String
  mimeType         String
  byteSize         Int
  originalFileName String
  uploadedById     String   @db.Uuid
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  uploadedBy       User     @relation("GuideUploader", fields: [uploadedById], references: [id])

  @@index([isPublished, sortOrder])
  @@map("guide_documents")
}

/// Soal MCQ A–D menempel di satu halaman cerita (opsional, maks 1).
model PageMcq {
  id             String   @id @default(uuid()) @db.Uuid
  pageId         String   @unique @db.Uuid
  prompt         String   @default("")
  /// Private Storage key (cermin-media), gambar soal opsional.
  promptImageKey String?
  /// Jawaban benar: A | B | C | D
  correctKey     String
  page           StoryPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  choices        PageMcqChoice[]
  responses      SessionMcqResponse[]

  @@map("page_mcqs")
}

model PageMcqChoice {
  id        String  @id @default(uuid()) @db.Uuid
  mcqId     String  @db.Uuid
  /// A | B | C | D
  key       String
  labelText String  @default("")
  imageKey  String?
  mcq       PageMcq @relation(fields: [mcqId], references: [id], onDelete: Cascade)

  @@unique([mcqId, key])
  @@index([mcqId])
  @@map("page_mcq_choices")
}

model LearningSession {
  id           String    @id @default(uuid()) @db.Uuid
  studentId    String    @db.Uuid
  storyId      String    @db.Uuid
  ledByUserId  String    @db.Uuid
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  student      Student   @relation(fields: [studentId], references: [id])
  story        Story     @relation(fields: [storyId], references: [id])
  ledBy        User      @relation(fields: [ledByUserId], references: [id])
  observations SessionObservation[]
  mcqResponses SessionMcqResponse[]

  // Riwayat sesi: per murid / pemandu + urutan waktu
  @@index([studentId, startedAt(sort: Desc)])
  @@index([ledByUserId, startedAt(sort: Desc)])
  @@index([storyId])
  @@index([endedAt, startedAt(sort: Desc)])
  @@map("learning_sessions")
}

model SessionObservation {
  id           String          @id @default(uuid()) @db.Uuid
  sessionId    String          @db.Uuid
  recordedById String          @db.Uuid
  note         String
  recordedAt   DateTime        @default(now())
  session      LearningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  recordedBy   User            @relation(fields: [recordedById], references: [id])

  // getSessionForReader: where sessionId order recordedAt desc
  @@index([sessionId, recordedAt(sort: Desc)])
  @@map("session_observations")
}

model SessionMcqResponse {
  id          String          @id @default(uuid()) @db.Uuid
  sessionId   String          @db.Uuid
  pageMcqId   String          @db.Uuid
  selectedKey String
  session     LearningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  mcq         PageMcq         @relation(fields: [pageMcqId], references: [id], onDelete: Cascade)

  @@unique([sessionId, pageMcqId])
  @@index([sessionId])
  @@index([pageMcqId])
  @@map("session_mcq_responses")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

/// Branding lembaga (singleton id = default). Logo di bucket privat cermin-media.
model InstitutionBranding {
  id          String   @id @db.VarChar(32)
  /// Storage key privat (bukan URL publik).
  logoKey     String?
  logoMime    String?
  /// Nama lembaga untuk footer / chrome publik.
  name        String?  @db.VarChar(200)
  address     String?  @db.Text
  websiteUrl  String?  @db.VarChar(500)
  instagramUrl String? @db.VarChar(500)
  facebookUrl String?  @db.VarChar(500)
  youtubeUrl  String?  @db.VarChar(500)
  whatsappUrl String?  @db.VarChar(500)
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  @@map("institution_branding")
}
